# Copy to .env and change the passwords (letters and digits only - they are used inside a connection URL).
# .env is git-ignored - never commit it.
AIRFLOW_UID=50000
# Postgres server (hosts both the Airflow metadata DB and the warehouse DB)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_airflow
POSTGRES_DB=airflow
# Warehouse database used by the pipeline and by Power BI
NEXUSMART_DB_NAME=nexusmart
NEXUSMART_DB_USER=nexusmart
NEXUSMART_DB_PASSWORD=change_me_warehouse
# Airflow web UI login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
# Port on your computer where Power BI connects to the warehouse
WAREHOUSE_HOST_PORT=5433
