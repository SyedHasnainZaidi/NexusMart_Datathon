model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Server", "Database", "fact_sales", "dim_date", "dim_customer", "dim_product", "dim_seller", "dim_location", "dq_rejects", "dq_checks"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table fact_sales
ref table dim_date
ref table dim_customer
ref table dim_product
ref table dim_seller
ref table dim_location
ref table dq_rejects
ref table dq_checks

ref cultureInfo en-US
